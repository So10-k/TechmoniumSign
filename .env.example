# Public application URLs
PUBLIC_URL=https://legal.example.com
GENERATE_SOURCEMAP=false
REACT_APP_SERVERURL=https://legal.example.com/api/app

# Parse application identity. Generate unique values per installation.
REACT_APP_APPID=
APP_ID=
appName=Techmonium Sign
MASTER_KEY=
PARSE_MOUNT=/app
SERVER_URL=https://legal.example.com/api/app

# MongoDB. Production Compose resolves `mongo` on its private Docker network.
MONGODB_URI=mongodb://mongo:27017/techmoniumsign

# Local persistent document storage. Configure the S3-compatible variables
# instead when local storage is not appropriate.
USE_LOCAL=true
DO_SPACE=
DO_ENDPOINT=
DO_BASEURL=
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_REGION=

# Outbound signing invitations. Leave disabled until all SMTP values are set.
SMTP_ENABLE=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER_EMAIL=
SMTP_PASS=

# Document signing certificate. Never commit either value.
PFX_BASE64=
PASS_PHRASE=
